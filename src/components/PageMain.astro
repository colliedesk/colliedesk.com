---
// Main content of a standard page: hero (with the Founding card beside it on /pricing), optional block
// (pricing plans, or the /vs price chart and fit columns), then the prose, with the docs navigation
// beside it on docs pages.
import { createElement } from 'react';
import type { Page } from '../lib/page';
import { html } from '../lib/render-react';
import { AuditForm } from './AuditForm';
import { DocsNav } from './DocsNav';
import { Hero } from './Hero';
import { PricingHero, PricingPlans, SwitchPlans } from './PricingPlans';
import Prose from './Prose.astro';
import { VsFit, VsPriceChart } from './VsPriceChart';

interface Props {
  page: Page;
}

const { page } = Astro.props;
const auditAside = page.pre === 'audit-form' ? createElement(AuditForm) : undefined;
---
{page.pre === 'pricing-plans' ? <Fragment set:html={html(PricingHero, { page })} /> : <Fragment set:html={html(Hero, { page, aside: auditAside })} />}
{page.pre === 'pricing-plans' && <Fragment set:html={html(PricingPlans, {})} />}
{page.pre === 'switch-plans' && <Fragment set:html={html(SwitchPlans, {})} />}
{page.vs && (
  <div class="wrap vs-top">
    <Fragment set:html={html(VsPriceChart, { pricing: page.vs })} />
    <Fragment set:html={html(VsFit, { pricing: page.vs })} />
  </div>
)}
<div class="wrap page-body">
  {page.docsNav ? (
    <div class="docs-layout"><Fragment set:html={html(DocsNav, { groups: page.docsNav, current: page.path })} /><Prose page={page} /></div>
  ) : (
    <Prose page={page} />
  )}
</div>
