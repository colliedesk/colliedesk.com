---
import { HERO_JPEG_SRCSET, HERO_MOBILE_MEDIA, HERO_MOBILE_SIZES, HERO_SIZES, heroMobileSrcset, heroSrcset } from '../../lib/hero-image';
import { HOME_DEMO } from '../../lib/home-demo';
import { html } from '../../lib/render-react';
import { AgentSection } from './AgentSection';
import { ClosingCta, ClosingSections } from './ClosingSections';
import { Facts, MigrationSection } from './FeatureSections';
import { HeroCopy } from './HomeHero';
import { ReconcileProof } from './ReconcileProof';
import { SellingSections } from './SellingSections';
import { StatusSection } from './StatusSection';

// One sheet under a hairline, one idea per row (Paper "L1-b Landing"). The hero picture is the inbox
// with an owned ticket, a private note and a reply draft waiting for a person, with the migration proof
// over its corner; phones get three crops of it instead (art direction), so the text stays readable.
// The picture comes from the app design for now (owner 06/11); `pnpm shot:product` replaces the 2x
// screenshot with an app capture once those screens ship. Under it, a silent demo video of the real app
// (src/lib/home-demo.ts) lets a visitor see the product without signing up.
---
<div class="wrap home-wrap"><div class="sheet">
<section class="sheet-row home-hero" aria-labelledby="hero-title">
  <Fragment set:html={html(HeroCopy, {})} />
</section>
<div class="sheet-row stage hero-stage">
  <figure class="hero-shot"><picture><source media={HERO_MOBILE_MEDIA} type="image/avif" srcset={heroMobileSrcset("avif")} sizes={HERO_MOBILE_SIZES} width="700" height="1036"><source media={HERO_MOBILE_MEDIA} type="image/webp" srcset={heroMobileSrcset("webp")} sizes={HERO_MOBILE_SIZES} width="700" height="1036"><source type="image/avif" srcset={heroSrcset('avif')} sizes={HERO_SIZES}><source type="image/webp" srcset={heroSrcset('webp')} sizes={HERO_SIZES}><img src="/product-inbox.jpg" srcset={HERO_JPEG_SRCSET} sizes={HERO_SIZES} width="1440" height="900" alt="The Colliedesk inbox: a refund ticket from Hana Sato, open, urgent and assigned to Hoàng Tú, with a private note from Hoàng Tú and a reply drafted through Claude's agent token, marked Not sent, waiting for a person to send it." fetchpriority="high"></picture></figure>
  <Fragment set:html={html(ReconcileProof, {})} />
</div>
<p class="sheet-row hero-caption"><span>The Colliedesk inbox: a ticket with its owner, a private note, and a reply your AI agent drafted for a person to send.</span> <span class="soon-text">Chat widget: coming Q1 2027</span></p>
<div class="sheet-row stage hero-demo">
  <figure class="hero-video">
    <video controls muted playsinline preload="none" poster={HOME_DEMO.poster} width={HOME_DEMO.width} height={HOME_DEMO.height} aria-label={HOME_DEMO.label}><source src={HOME_DEMO.mp4} type="video/mp4"><source src={HOME_DEMO.webm} type="video/webm">Your browser cannot play this video. <a href={HOME_DEMO.mp4}>Download the MP4</a>.</video>
    <figcaption>{HOME_DEMO.caption}</figcaption>
  </figure>
</div>
<Fragment set:html={html(Facts, {})} />
<Fragment set:html={html(MigrationSection, {})} />
<Fragment set:html={html(AgentSection, {})} />
<Fragment set:html={html(SellingSections, {})} />
<Fragment set:html={html(StatusSection, {})} />
<Fragment set:html={html(ClosingSections, {})} />
<Fragment set:html={html(ClosingCta, {})} />
</div></div>
